# Ensure proper index
DirectoryIndex index.php index.html

# Prevent directory browsing
Options -Indexes

# URL Rewrites and Clean Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct HTTP access to internal include scripts
    RewriteRule ^includes/ - [F,L]

    # Rewrite sitemap.xml to dynamic sitemap generator
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Clean API gateway routing for frontend API bridge
    RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
    RewriteRule ^api$ api.php [QSA,L]

    # Clean publication download routing
    RewriteRule ^download-publication$ download-publication.php [QSA,L]

    # Support extensionless PHP URLs (e.g. /about -> about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# Ensure MIME types for modern media formats
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/x-icon .ico
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/ogg .ogv
    AddType video/quicktime .mov
    AddType application/pdf .pdf
</IfModule>

# Protect sensitive files and directories
<FilesMatch "^\.env|\.env\.|\.ini$|\.log$|\.sql$|composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# Deny access to hidden dotfiles
<Files ".*">
    Require all denied
</Files>
<FilesMatch "^\.(well-known)">
    Require all granted
</FilesMatch>

# Allow normal public web files
<FilesMatch "\.(php|html|htm|css|js|png|jpg|jpeg|gif|webp|svg|ico|mp4|webm|ogv|mov|woff|woff2|ttf|eot|xml|txt|pdf)$">
    Require all granted
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
