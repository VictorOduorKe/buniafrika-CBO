# Ensure proper index
DirectoryIndex index.php index.html

# Prevent directory browsing
Options -Indexes

# Rewrite sitemap.xml to dynamic sitemap generator
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Ensure MIME types for modern media formats
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/x-icon .ico
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/ogg .ogv
    AddType video/quicktime .mov
</IfModule>

# Protect sensitive files and directories
<FilesMatch "^\.env|\.env\.|\.ini$|\.log$|\.sql$|composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# Deny access to hidden dotfiles
<Files ".*">
    Require all denied
</Files>
<FilesMatch "^\.(well-known)">
    Require all granted
</FilesMatch>

# Allow normal public web files
<FilesMatch "\.(php|html|htm|css|js|png|jpg|jpeg|gif|webp|svg|ico|mp4|webm|ogv|mov|woff|woff2|ttf|eot|xml|txt)$">
    Require all granted
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
